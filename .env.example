# Copy this file to .env or export the variables in your shell.
# Never commit real credential values.

# Alibaba Cloud Bailian / DashScope
DASHSCOPE_API_KEY=your_dashscope_api_key
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com
DASHSCOPE_CHAT_MODEL=qwen-plus
DASHSCOPE_EMBEDDING_MODEL=text-embedding-v3
DASHSCOPE_MULTI_MODEL=false

# Search services
SEARCH_API_KEY=your_search_api_key
PEXELS_API_KEY=your_pexels_api_key
AMAP_MAPS_API_KEY=your_amap_api_key

# Optional PostgreSQL / PgVector settings
DB_URL=jdbc:postgresql://localhost:5432/fan_ai_agent
DB_USERNAME=postgres
DB_PASSWORD=your_database_password

# Optional service overrides
SERVER_PORT=8123
IMAGE_MCP_URL=http://localhost:8127
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=gemma3:1b
SPRING_AI_LOG_LEVEL=INFO
